# 빌드 시 정적 페이지에 구워지는 값입니다. API 키는 여기에 넣지 않습니다.
# 키·주소·모델은 사이트 설정의 「AI 설정」에서 입력하며 이 브라우저의 localStorage에만 남습니다.

# 질문 + 공통 지문 + 선택한 문제 + 첨부 파일 본문의 글자 수 한도
CONTEXT_CHAR_LIMIT=20000

# 문제 세트(응시)당 AI 질문 횟수
AI_REQUEST_LIMIT=10

# false 이면 지문·문제·파일 뷰어 복사 방지를 끕니다
COPY_PROTECTION=true

# 비우면 basePath 없음(로컬 npm run dev). 미설정 빌드는 /ai-assessment-practice
# NEXT_PUBLIC_BASE_PATH=/ai-assessment-practice
